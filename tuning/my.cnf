# Step7/8: MySQL 設定チューニング（ドロップイン）
# 配置先: /etc/mysql/mysql.conf.d/zz-tuning.cnf （既定 my.cnf より後に読まれる名前にする）
# 反映: MySQL 再起動が必要（`sudo systemctl restart mysql`、またはEC2再起動）。
#
# 目的:
#  1) innodb_buffer_pool_size: 128MB(デフォルト) → 1GB。タイムライン/コメントの作業集合をメモリ常駐させ
#     ディスク読みを削減（3.7GBメモリのうち1GB。Go/nginx/memcached/benchと共有のため過大にしない）。
#  2) disable_log_bin: バイナリログ無効化。単一ノードのベンチではbinlogは純オーバーヘッド。
#     書込み同期コスト削減 ＋ binlogによるディスク肥大（今回の100%枯渇の主因の一つ）を恒久停止。
#     ※既存の binlog ファイルは自動削除されない。下記 runbook で先に PURGE/削除すること。
#  3) innodb_flush_log_at_trx_commit: 1 → 2。コミット毎の redo fsync を毎秒1回に緩和し書込みレイテンシ短縮
#     （クラッシュ時に最大1秒の更新を失う可能性。ベンチ用途では許容）。
#  4) sync_binlog は disable_log_bin により無効化されるため指定不要。

[mysqld]
innodb_buffer_pool_size = 1G
disable_log_bin
innodb_flush_log_at_trx_commit = 2

# 任意（書込みが律速になってきたら検討）:
# innodb_redo_log_capacity = 512M
# innodb_io_capacity = 2000
